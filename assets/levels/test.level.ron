// Test level for development: one portrait screen of open sky.
// Format reference: docs/LEVELS.md
(
    name: "Test Fall",
    theme: DeepSpace,
    start: (540, 200),
    beacon: (center: (540, 1880), size: (300, 40)),
    stardust: [
        (260, 700),
        (820, 1100),
        (360, 1500),
    ],
    objects: [
        // Right under the start: every attempt meets it first.
        CloudPuff(center: (580, 640), radius: 90),
        // Off the straight path: a plain drop misses it, drifting left doesn't.
        StaticCloud(center: (330, 1250), radius: 95),
        // Near the right-hand mote: sends you back toward the middle.
        Crystal(center: (900, 1350), size: 50),
        // Left side, flowing down and right toward the beacon: a shortcut,
        // if you notice which way the chevrons point.
        WindRibbon(path: [(90, 1450), (250, 1600), (460, 1700)], width: 90),
    ],
    target_time: 8.0,
)
