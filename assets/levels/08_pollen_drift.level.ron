// Introduce: a flower swaps your controls in open sky.
// Test: the next mote is to the left, while left means right.
// Twist: a crystal turns you around while the spores still hold.
// Letting go drops you past the beacon, off to its left.
(
    name: "Pollen Drift",
    theme: WarmEvening,
    start: (540, 180),
    beacon: (center: (760, 1870), size: (300, 40)),
    stardust: [
        (300, 1020),
        (780, 1480),
        (700, 1740),
    ],
    objects: [
        SporeFlower(center: (540, 600), radius: 60),
        Crystal(center: (840, 1320), size: 55),
        CloudPuff(center: (300, 1600), radius: 80),
    ],
    target_time: 6.0,
)
