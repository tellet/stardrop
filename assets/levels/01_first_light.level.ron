// Introduce: the fall itself, and the beacon straight below.
// Test: three motes on a gentle zigzag teach steering.
// Twist: two soft clouds on the way down, which teach that touching things
// is the point: each one plays the next note of the level's phrase.
(
    name: "First Light",
    theme: DeepSpace,
    start: (540, 180),
    beacon: (center: (540, 1870), size: (320, 40)),
    stardust: [
        (400, 650),
        (660, 1080),
        (430, 1520),
    ],
    objects: [
        CloudPuff(center: (380, 780), radius: 85),
        CloudPuff(center: (680, 1210), radius: 85),
    ],
    phrase: 2,
)
